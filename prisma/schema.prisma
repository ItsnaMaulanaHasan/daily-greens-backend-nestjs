// datasource db {
//   provider = "postgresql"
// }

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserGender {
  MALE
  FEMALE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  CANCELLATION
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.Text
  roleId          String     @map("role_id") @db.Uuid
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz()

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  // relations
  profile       Profile?
  role          Role     @relation(fields: [roleId], references: [id])
  createdByUser User?    @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?    @relation("UserDeletedBy", fields: [deletedBy], references: [id])

  // relations audit colom
  // user
  usersCreated User[] @relation("UserCreatedBy")
  usersUpdated User[] @relation("UserUpdatedBy")
  usersDeleted User[] @relation("UserDeletedBy")

  // Role
  rolesCreated Role[] @relation("RoleCreatedBy")
  rolesUpdated Role[] @relation("RoleUpdatedBy")
  rolesDeleted Role[] @relation("RoleDeletedBy")

  // permission
  permissionsCreated Permission[] @relation("PermissionCreatedBy")
  permissionsUpdated Permission[] @relation("PermissionUpdatedBy")
  permissionsDeleted Permission[] @relation("PermissionDeletedBy")

  // stock movement
  stockMovementCreated StockMovement[] @relation("StockMovementCreatedBy")

  @@index([roleId])
  @@map("users")
}

model Profile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  fullName    String      @map("full_name") @db.VarChar(255)
  avatarUrl   String?     @map("avatar_url") @db.Text
  address     String?     @db.Text
  phoneNumber String?     @map("phone_number") @db.VarChar(20)
  birthDate   DateTime?   @map("birth_date") @db.Date
  gender      UserGender?

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  // relations
  users           User[]
  rolePermissions RolePermission[]
  createdByUser   User?            @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?            @relation("RoleUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser   User?            @relation("RoleDeletedBy", fields: [deletedBy], references: [id])

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(150)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  // relations
  rolePermissions RolePermission[]
  createdByUser   User?            @relation("PermissionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?            @relation("PermissionUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser   User?            @relation("PermissionDeletedBy", fields: [deletedBy], references: [id])

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId])
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model ProductCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  description String? @db.Text
  imageUrl    String? @db.Text
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime @map("deleted_at") @db.Timestamptz()

  // relations
  products Product[]

  @@index([isActive, position])
  @@map("product_categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)

  allowCustomerNote Boolean @default(true) @map("allow_customer_note")
  notePlaceholder   String? @map("note_placeholder") @db.VarChar(255)

  preparationTimeMinutes Int?    @map("preparation_time_minutes")
  isFeatured             Boolean @default(false) @map("is_featured")
  position               Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  // relations
  category ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  options  ProductOption[]
  variants ProductVariant[]

  @@index([categoryId, status])
  @@index([status, position])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  imageUrl  String  @map("image_url") @db.Text
  publicId  String  @unique @map("public_id") @db.VarChar(255)
  altText   String? @map("alt_text") @db.VarChar(255)
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime @map("deleted_at") @db.Timestamptz()

  // relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductOption {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String  @db.VarChar(100)
  displayName String  @map("display_name") @db.VarChar(100)
  isRequired  Boolean @default(true) @map("is_required")
  position    Int     @default(0)

  // relations
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([productId, name])
  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id       String  @id @default(uuid()) @db.Uuid
  optionId String  @map("option_id") @db.Uuid
  value    String  @db.VarChar(100)
  label    String  @db.VarChar(100)
  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  // relations
  option              ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptionValues VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, position])
  @@map("product_option_values")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku       String @unique @db.VarChar(100)
  name      String @db.VarChar(255)

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @map("cost_price") @db.Decimal(12, 2)

  stock      Int     @default(0)
  trackStock Boolean @default(true) @map("track_stock")
  isDefault  Boolean @default(false) @map("is_default")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  // relations
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  stockMovements StockMovement[]

  @@index([productId, isActive])
  @@index([productId, isDefault])
  @@index([deletedAt])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("variant_value_id") @db.Uuid

  // relations
  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  type      StockMovementType

  quantityChange Int @map("reference_type")
  stockBefore    Int @map("stock_before")
  stockAfter     Int @map("stock_after")

  referenceType String? @map("references_type") @db.VarChar(50)
  referenceId   String? @map("reference_id") @db.Uuid
  note          String? @db.Text

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // relations
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdByUser User?          @relation("StockMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([referenceId])
  @@index([createdBy])
  @@map("stock_movements")
}
